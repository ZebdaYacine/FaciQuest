# Keep the build context small and, more importantly, keep stale artifacts out.
# This directory currently holds committed build output (dashboard-web.tar.gz,
# web-release.zip, web_build.tar.gz) which must never end up in the image.
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
*.tar.gz
*.zip

# Written inside the Dockerfile from build args. A developer's local .env
# leaking into the context would silently win over the intended production one.
.env

ios/
android/
macos/
linux/
windows/
test/

.git/
.gitignore
.idea/
.vscode/
*.iml
Dockerfile
.dockerignore
README.md
*.md
