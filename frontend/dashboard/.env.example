# FaciQuest Dashboard Environment Configuration
# API Configuration
API_BASE_URL=http://185.209.230.104:3000
API_TIMEOUT=30000

# Authentication Configuration
AUTH_TOKEN_KEY=dashboard_auth_token
AUTH_REFRESH_TOKEN_KEY=dashboard_refresh_token

# App Configuration
APP_NAME=FaciQuest Admin Dashboard
APP_VERSION=1.0.0
DEBUG_MODE=true

# Pagination Configuration
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Cache Configuration
CACHE_DURATION_MINUTES=5

# UI Configuration
DEFAULT_THEME_COLOR=0xFF2196F3
ENABLE_RESPONSIVE_BREAKPOINTS=true

# Analytics Configuration
ANALYTICS_ENABLED=true
ANALYTICS_TRACKING_ID=

# Error Handling
SHOW_DETAILED_ERRORS=true
LOG_LEVEL=debug
